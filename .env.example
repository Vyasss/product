# All variables are read at BUILD time by Vite and inlined into the static bundle.
# Never put secrets here: anything prefixed VITE_ is visible to every visitor.
# Copy to .env.local for local overrides.

# Base URL of a real product API. When set, the app fetches `${VITE_API_BASE_URL}/products`
# instead of using the local mock dataset. Leave empty to use the mock service.
VITE_API_BASE_URL=

# Mock service only: probability (0 to 1) that a request fails with a simulated 500.
# Other failure switches: add `?mockFail=2` to the URL to fail the first 2 loads of the page.
VITE_MOCK_FAIL_RATE=0

# Mock service only: show an on-page panel to fail the next request and reload.
VITE_ENABLE_MOCK_CONTROLS=false

# Show the "smart search" suggestion that turns phrases like "shoes under 5000 in stock"
# into structured filters. (Off by default)
VITE_FEATURE_SMART_SEARCH=false

# Public origin the site is served from, e.g. https://d1234abcd.cloudfront.net (no trailing
# slash). Used only for the link-preview image URL in index.html, which must be absolute.
VITE_SITE_URL=
